# Copy to .env (next to package.json) and fill in. Never commit .env.

# Admin panel password (at least 10 characters). Works in addition to the password
# set from the admin panel. The old public defaults (roya1403, admin123, roya2026)
# are always refused.
ADMIN_PASSWORD=

# Random key that signs admin login tokens (at least 16 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random key is created and stored in the database (data/roya.db).
SESSION_SECRET=

# Public address of the site, used in vCards and link previews.
PUBLIC_ORIGIN=https://card.royaco.com

# Optional: where the database and uploads live (defaults: ./data and ./public/uploads)
# DATA_DIR=
# UPLOADS_DIR=

# Optional: where the app keeps its daily database copies (default: DATA_DIR/backups).
# Point it at another disk if you have one.
# BACKUP_DIR=

PORT=3000
